<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp"
    android:background="@android:color/transparent">

    <!-- Основная клавиатура -->
    <LinearLayout
        android:id="@+id/keyboard_main_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/keyboard_background"
        android:padding="10dp">

        <!-- Верхняя панель: символы, запятая, точка, стереть -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btn_symbol_toggle"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="123"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_comma"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="," />

            <Button
                android:id="@+id/btn_dot"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="." />

            <Button
                android:id="@+id/btn_delete"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.5"
                android:layout_marginStart="6dp"
                android:background="@drawable/key_background"
                android:textColor="#FF5252"
                android:text="⌫ Стереть" />
        </LinearLayout>

        <!-- Ряд 1 для букв -->
        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Ряд 2 для букв -->
        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Ряд 3 для букв -->
        <LinearLayout
            android:id="@+id/row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="6dp" />

        <!-- Нижний ряд: Глобус, Шифт, Пробел, Ввод -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_language"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.0"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="🌐 RU"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_shift"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.0"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="⇧"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_space"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2.5"
                android:layout_marginEnd="6dp"
                android:background="@drawable/key_background"
                android:textColor="#FFFFFF"
                android:text="пробел"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_enter"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2.0"
                android:background="@drawable/key_background"
                android:textColor="#00E5FF"
                android:text="↵ Ввод"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

    <!-- Экран тревоги с большой кнопкой остановки музыки -->
    <LinearLayout
        android:id="@+id/alarm_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6111111"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_stop_alarm"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/key_background"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="ОСТАНОВИТЬ МУЗЫКУ (Ждите... 15с)"
            android:textAllCaps="false" />

    </LinearLayout>

</FrameLayout>